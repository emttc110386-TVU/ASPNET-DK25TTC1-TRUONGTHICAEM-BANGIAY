<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop Bán Giày CAEM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body style="background-color: #faf8f5;">
    <!-- HEADER MÀU VÀNG THỂ THAO -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3" style="background-color: #ffb703;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-dark fs-3 me-4" asp-area="" asp-controller="Home" asp-action="Index">
                    👟 Bangiay<span class="text-white">CAEM</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold px-3" asp-area="" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold px-3" asp-area="" asp-controller="Cart" asp-action="Index">🛒 Giỏ hàng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold px-3" asp-area="" asp-controller="Categories" asp-action="Index">Quản lý Danh mục</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-bold px-3" asp-area="" asp-controller="Products" asp-action="Index">Quản lý Giày</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- 👉 PHẦN QUAN TRỌNG NHẤT: RENDERBODY ĐỂ NẠP NỘI DUNG TỪ INDEX.CSHTML -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER MỚI NHIỀU CỘT CHUYÊN NGHIỆP -->
    <footer class="bg-white border-top mt-5 pt-4 pb-3">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="fw-bold" style="color: #ff6b00;">👟 BangiayCAEM</h5>
                    <p class="text-muted small">Hệ thống phân phối giày thể thao, sneaker chính hãng hàng đầu. Đem lại sự thoải mái trên từng bước chân.</p>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-dark">Khám phá</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-1"><a href="#" class="text-decoration-none text-muted">Trang chủ</a></li>
                        <li class="mb-1"><a href="#" class="text-decoration-none text-muted">Mẫu giày hot</a></li>
                        <li class="mb-1"><a href="#" class="text-decoration-none text-muted">Tin tức & Mẹo hay</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="fw-bold text-dark">Hỗ trợ khách hàng</h6>
                    <ul class="list-unstyled small text-muted">
                        <li class="mb-1">Hotline: 1900 1234</li>
                        <li class="mb-1">Email: emttc110386@tvu-onschool.edu.vn</li>
                        <li class="mb-1">Địa chỉ: Trà Vinh, Việt Nam</li>
                    </ul>
                </div>
            </div>
            <hr>
            <div class="text-center text-muted small">
                &copy; 2026 BangiayCAEM - Tất cả các quyền được bảo lưu.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>