@model List<BangiayCAEM.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container py-4">
    <h3 class="fw-bold mb-4" style="color: #222;">🛒 Giỏ hàng của bạn</h3>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning rounded-4 p-4 text-center">
            <h5>Giỏ hàng đang trống!</h5>
            <p class="mb-3">Hãy chọn cho mình những đôi giày ưng ý nhất nhé.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-warning text-white fw-bold px-4" style="background-color: #ff6b00; border: none;">Quay lại cửa hàng</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="table-responsive bg-white rounded-4 shadow-sm p-3 border">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@item.ImageUrl" style="width: 50px; height: 50px; object-fit: contain;" alt="@item.ProductName">
                                            <span class="fw-bold">@item.ProductName</span>
                                        </div>
                                    </td>
                                    <td>@string.Format("{0:N0}đ", item.Price)</td>
                                    <td><span class="badge bg-secondary fs-6">@item.Quantity</span></td>
                                    <td class="text-danger fw-bold">@string.Format("{0:N0}đ", item.Total)</td>
                                    <td>
                                        <a asp-action="RemoveFromCart" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-danger rounded-circle">✕</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="bg-white p-4 rounded-4 shadow-sm border">
                    <h5 class="fw-bold mb-3">Tóm tắt đơn hàng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tổng tiền hàng:</span>
                        <span class="fw-bold text-danger fs-5">@string.Format("{0:N0}đ", ViewBag.Total)</span>
                    </div>
                    <hr>
                    <button class="btn btn-success w-100 fw-bold py-2 mb-2 rounded-3" onclick="alert('Đặt hàng thành công! Cảm ơn bạn đã mua hàng tại BangiayCAEM.')">Thanh toán ngay 💳</button>
                    <a asp-action="ClearCart" class="btn btn-outline-secondary w-100 btn-sm rounded-3">Xóa toàn bộ giỏ hàng</a>
                </div>
            </div>
        </div>
    }
</div>